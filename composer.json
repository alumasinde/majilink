{
    "name": "majilink/app",
    "description": "MajiLink neighbourhood water delivery platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "MajiLink\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:services": "phpunit --testsuite services",
        "test:api": "php tests/api_smoke.php"
    },
    "config": {
        "sort-packages": true
    }
}
