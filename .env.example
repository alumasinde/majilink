# Set to "production" on the live server (also disables dev OTP exposure).
APP_ENV=local
APP_DEBUG=1
APP_NAME=MajiLink
# Live origin. Production ignores loopback values and falls back to https://majilink.co.ke.
APP_URL=https://majilink.co.ke
# Local development: APP_URL=http://localhost:8099
APP_KEY=change-me-to-a-32-byte-random-string

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=majilink
DB_USER=root
DB_PASS=majilink_dev

MAIL_FROM=no-reply@majilink.co.ke
MAIL_FROM_NAME=MajiLink
OTP_DEV_EXPOSE=1

# Demo seed data (customers, vendors, pins, orders). Required for local demo seeding only.
# Production never seeds demo data, even if this is set.
SEED_DEMO_PASSWORD=

# First admin created by the seeder on a fresh deployment. Leave blank to skip.
# Set all four; SEED_ADMIN_EMAIL is optional. Nothing is printed to the console.
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# M-Pesa Daraja (leave blank until keys are ready)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SIMULATE=1

# Push (Firebase). Leave blank to store notifications only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Road routing (OSRM-compatible). Falls back to Haversine when unreachable.
ROUTING_URL=https://router.project-osrm.org
